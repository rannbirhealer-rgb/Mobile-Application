<?xml version="1.0" encoding="utf-8"?>
<!--
    Same policy as backup_rules.xml, for Android 12 and later: keep the Parent Mode PIN hash and the
    counselor's API key out of cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="alarmboss_parent_mode_prefs.xml" />
        <exclude domain="sharedpref" path="alarmboss_counselor_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="alarmboss_parent_mode_prefs.xml" />
        <exclude domain="sharedpref" path="alarmboss_counselor_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
