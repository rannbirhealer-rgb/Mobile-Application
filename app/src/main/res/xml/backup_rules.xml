<?xml version="1.0" encoding="utf-8"?>
<!--
    Alarms, settings and progress may be backed up. Secrets stay on the device: the Parent Mode PIN
    hash and the counselor's API key must not travel to cloud storage or another phone, where a
    restored copy could be read or reused.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="alarmboss_parent_mode_prefs.xml" />
    <exclude domain="sharedpref" path="alarmboss_counselor_prefs.xml" />
</full-backup-content>
